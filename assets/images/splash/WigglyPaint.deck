toolProps:{"type":"field","size":[71,14],"pos":[40,292],"show":"none","value":"{\"marker\":4,\"eraser\":6}"}

{script:main.0}
on backup do
 history.value:raze each frame in target.frames
  rtext.make["" "" frame.copy[]]
 end
end

on mask x do
 hi32.toggle["transparent" x]
 target.show:if x "transparent" else "solid" end
 crop.widgets.preview.show:target.show
end

on mirror vh do
 target.mirrormode:vh
end

on changetool x do
 if x~"eraser"
  sizeLabel.text:"eraser size"
  markerSizes.valueIndex:toolProps.data.eraser
 else
  sizeLabel.text:"marker size"
  markerSizes.valueIndex:toolProps.data.marker
 end
end
{end}

{script:main.1}
on click do
 others:me drop extract value where value..def.name="popOut" from card.widgets
 others..value:1
 if !me.value play["pick"] end
 me.value:0
 target.brush:me.name
 changetool[me.name]
end
{end}

{script:main.2}
on begin do
 backup[]
end
{end}

{script:main.3}
on oval pos size do
 flip pos+size*flip unit 2*pi*(range 20)/20
end

on shake obj tick do
  local st: 10 # time
  local sm: 15 # magnitude
  local sf:0.5 # fade
  local so:obj.pos
  while sm>0
    st:st-1
    obj.pos:so+random[sm,-sm 2]
    if st<0 sm:sm-sf end
    tick[]
  end
  obj.pos:so
end

on click do
 backup[]
 play["boom"]
 t:target.canv
 local s:()
 shake[target on tick do
  t.pattern:0
  each v in s t.poly[v] end
  s:each _ in range 5
   oval[random[max target.size 2] 10+random[30]]
  end
  t.pattern:1
  each v in s t.poly[v] end
  sleep[] 
 end]
 t.pattern:1
 target.pos:dims.pos
 target.size:dims.size
 each f in target.frames f.map[() 0] end
end
{end}

{script:main.4}
on click do
 play["snap"]
 t:if options.widgets.mask.value () else 0 dict 32 end
 gif.frames:target.frames..copy[].map[t]
 gif.delays:3 take 10
 write[gif]
end
{end}

{script:main.5}
on click do
 play["snap"]
 crop.event.init
 go["crop" "BoxIn" 15]
end
{end}

{script:main.6}
on click do
 play["erase2"]
 h:extract arg where arg..type="image" from history.value
 f:target.frames..copy[]
 if count h
  target.size:h[0].size
  target.pos:dims.pos+(dims.size-target.size)/2
  each frame i in target.frames
   frame.size:h[i].size
   frame.paste[h[i]]
   h[i].size:f[i].size
   h[i].paste[f[i]]
  end
 end
end
{end}

{script:main.7}
on click do
 play["snap"]
 go["options" "BoxIn" 15]
end
{end}

{script:main.8}
on change img index do
 play["click"]
 p:toolProps.data
 if sizeLabel.text~"marker size"
  target.hishape:img.encoded
  p.marker:index
 else
  target.ershape:img.encoded
  p.eraser:index
 end
 toolProps.data:p
end
{end}

{card:crop}
image:"%%"
script:"crop.0"
{widgets}
dims:{"type":"button","size":[355,261],"pos":[76,48],"show":"none"}
preview:{"type":"canvas","size":[355,261],"pos":[76,48],"locked":1,"pattern":255,"image":"%%","scale":1}
cancel:{"type":"button","size":[97,50],"pos":[1,299],"script":"crop.1","style":"invisible"}
apply:{"type":"button","size":[117,63],"pos":[396,284],"script":"crop.2","style":"invisible"}
reset:{"type":"button","size":[88,31],"pos":[284,313],"script":"crop.3","style":"invisible"}
left:{"type":"slider","size":[59,25],"pos":[11,227],"interval":[0,355],"style":"compact"}
right:{"type":"slider","size":[59,25],"pos":[437,227],"interval":[0,355],"style":"compact"}
bottom:{"type":"slider","size":[59,25],"pos":[220,313],"interval":[0,261],"style":"compact"}
top:{"type":"slider","size":[59,25],"pos":[220,19],"interval":[0,261],"style":"compact"}
fit:{"type":"button","size":[80,20],"pos":[123,317],"locked":1,"script":"crop.4","text":"Tight Fit"}
mhoriz:{"type":"button","size":[68,32],"pos":[3,25],"script":"crop.5","text":"Flip Horizontal","value":0}
mvert:{"type":"button","size":[59,33],"pos":[8,91],"script":"crop.6","text":"Flip Vertical","value":0}
xray:{"type":"button","size":[59,32],"pos":[444,25],"script":"crop.7","text":"X-Ray","value":0}

{script:crop.0}
on init do
 mvert .value:0
 mhoriz.value:0
 xray  .value:0
 reset.event.click
end

on getframe do
 (first main.widgets.target.frames).copy[]
end

on scrungle img do
 if mvert.value  img.transform.vert    end
 if mhoriz.value img.transform.horiz   end
 if xray.value   img.map[(0 dict 1) 0] end
 img
end

on change do
 play["click"]
 view[]
end

on view do
 t:main.widgets.target
 f:scrungle[getframe[]]
 
 mvert .show:("solid","invert")[mvert .value]
 mhoriz.show:("solid","invert")[mhoriz.value]
 xray  .show:("solid","invert")[xray  .value]
 preview.size:t.size
 preview.pos:dims.pos+(dims.size-preview.size)/2
 preview.paste[f]
 preview.pattern:255 # ANTS!
 
 top   .interval:0,t.size[1]
 bottom.interval:0,t.size[1]
 left  .interval:t.size[0],0
 right .interval:t.size[0],0
 
 preview.line[left.value,0 left.value,t.size[1]]
 preview.line[0,top.value  t.size[0],top.value ]
 preview.line[(t.size[0]-right.value),0  (t.size[0]-right.value),t.size[1]]
 preview.line[0,(t.size[1]-bottom.value) t.size[0],(t.size[1]-bottom.value)]
 
 fit.locked:(list 0)~keys t.frames[0].hist
end
{end}

{script:crop.1}
on click do
 play["cancel"]
 go["main" "BoxOut" 15]
end
{end}

{script:crop.2}
on click do
 main.event["backup"]
 t:main.widgets.target
 d:main.widgets.dims
 
 p:left.value,top.value
 m:right.value,bottom.value
 s:preview.size-p+m
 
 each frame in t.frames
  f:scrungle[frame.copy[]]
  c:f.copy[p s]
  frame.size:s
  frame.paste[c]
 end
 
 t.size:s
 t.pos:d.pos+(d.size-t.size)/2
 
 play["scratch"]
 go[main "BoxOut" 15]
end
{end}

{script:crop.3}
on click do
  play["pick"]
  top   .value:0
  left  .value:0
  right .value:0
  bottom.value:0
  view[]
end
{end}

{script:crop.4}
on tween t a b do
 a+(b-a)*t^2
end

on click do
 reset.event["click"]
 f:scrungle[main.widgets.target.frames[0].copy[]]
 w:f.size[0]
 h:f.size[1]
 on scan ctrl lim rect size step do
  done:0
  v:ctrl.value
  while (!done)&v<lim
   if 1<count keys f.copy[rect size].hist
    done:1
   else
    v:v+1
    rect:rect+step
   end
  end
  each t in range 11
   ctrl.value:tween[t/10 ctrl.value v]
   play["click"]
   view[]
   sleep[]
  end
 end
 scan[left   w (   0 ,   0 ) (1,h) ( 1, 0)]
 scan[right  w ((w-2),   0 ) (1,h) (-1, 0)]
 scan[top    h (   0 ,   0 ) (w,1) ( 0, 1)]
 scan[bottom h (   0 ,(h-2)) (w,1) ( 0,-1)]
end
{end}

{script:crop.5}
on click do
 play.pencil1
 me.value:!me.value
 view[]
end
{end}

{script:crop.6}
on click do
 play.pencil2
 me.value:!me.value
 view[]
end
{end}

{script:crop.7}
on click do
 play.erase1
 
 a:scrungle[getframe[]]
 me.value:!me.value
 me.show:("solid","invert")[me.value]
 b:scrungle[getframe[]]
 
 f:transition[].Melt
 d:30
 each t in range d+1
  preview.clear[]
  f[preview a b t/d]
  sleep[]
 end
 
 view[]
end
{end}

